"""Verify v2 preserves v1's public API surface exactly."""
import inspect
import os
import sys

sys.path.insert(0, os.getcwd())

import test_cli_interface as t
import cli_interface_v1 as v1
import cli_interface_v2 as v2

print("tests resolve to:", t.get_cli_interface().__module__)

ok = True
for name in ("display_report", "display_error"):
    a = [p.name for p in inspect.signature(getattr(v1.CLIInterface, name)).parameters.values()]
    b = [p.name for p in inspect.signature(getattr(v2.CLIInterface, name)).parameters.values()]
    match = a == b
    ok = ok and match
    print(f"{name}: v1={a} v2={b} match={match}")

pub1 = sorted(n for n in vars(v1.CLIInterface) if not n.startswith("_"))
pub2 = sorted(n for n in vars(v2.CLIInterface) if not n.startswith("_"))
methods2 = sorted(n for n in pub2 if callable(vars(v2.CLIInterface)[n]))

print("v1 public names:", pub1)
print("v2 public methods:", methods2)
print("public methods identical:", pub1 == methods2)

# Constructor must stay zero-arg.
v2.CLIInterface()
print("CLIInterface() zero-arg construction: OK")

print("RESULT:", "PASS" if ok and pub1 == methods2 else "FAIL")
